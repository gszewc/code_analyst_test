    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint . --ext .vue,.ts,.tsx",
    "format": "prettier --write src/ tests/"
  },
  "dependencies": {
