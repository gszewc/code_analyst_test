    "cytoscape": "^3.28.0",
    "cytoscape-fcose": "^2.2.0",
    "dompurify": "^3.0.0",
    "highlight.js": "^11.11.1",
    "lucide-vue-next": "^0.363.0",
    "marked": "^12.0.0",
    "pinia": "^2.1.0",
    "radix-vue": "^1.8.0",
    "tailwind-merge": "^2.2.0",
    "vee-validate": "^4.12.0",
    "vue": "^3.4.0",
    "vue-router": "^4.3.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
