# Legacy Code Analysis API - Environment Configuration

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Database Configuration
SQLITE_PATH=~/app-data/code_analyst/data/projects.sqlite
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# File Configuration
UPLOAD_DIR=~/app-data/code_analyst/uploads
MAX_UPLOAD_SIZE=20971520

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Application Metadata
APP_NAME=Legacy Code Analysis API
APP_VERSION=0.1.0
DEBUG=false

# Graph UI Defaults
# Controls which node types are visible by default in the graph view.
# Valid values: File, Module, Package, Class, Interface, Enum, Function, Method, Constructor, Variable, Import, ExternalModule
# GRAPH_DEFAULT_VISIBLE_NODES=Class,Interface,Enum,Function,Method

# Analysis Defaults
ANALYSIS_DEFAULT_DELETE_GRAPH_DATA=false
# ANALYSIS_DEFAULT_ENABLED_NODE_TYPES=File,Module,Package,Class,Function,Method,Variable,Import,ExternalModule
# ANALYSIS_DEFAULT_ENABLED_RELATIONSHIP_TYPES=CONTAINS,EXTENDS,IMPLEMENTS,CALLS,DEPENDS_ON,USES,IMPORTS,DEFINED_IN